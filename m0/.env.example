# ============ 编导 LLM（OpenAI 兼容协议） ============
# 负责创意策划：钩子字幕、卖点证据链、两镜脚本
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ============ 视觉模型（OpenAI 兼容协议，需支持图片输入） ============
# 负责"看商品图"识别 + 生成后抽帧质检（商品时机/多杯/真实饮用/液面）
VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VISION_BASE_URL=https://your-vision-endpoint/v1
VISION_MODEL=your-vision-model

# ============ 视频生成引擎（双引擎可切换） ============
# comfyui（默认）：自部署 ComfyUI + MiniMax H3 Ref2VA 工作流
# h3api：MiniMax 官方 API（设 VIDEO_ENGINE=h3api 切换；两引擎同接口，可用同一创意 A/B 对比）
# VIDEO_ENGINE=comfyui
# H3_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# H3_API_BASE_URL=https://api.minimaxi.com/v1
# H3_API_MODEL=MiniMax-H3
# 以下路径一般无需改（字段映射集中在 pipeline/h3_api.py 的 _payload，按官方文档校正）
# H3_API_SUBMIT_PATH=/video_generation
# H3_API_QUERY_PATH=/query/video_generation
# H3_API_FILES_PATH=/files/retrieve

# ============ 远端 ComfyUI（comfyui 引擎使用） ============
COMFYUI_HOST=http://your-comfyui-host:8188
# 走 Basic Auth 代理时填写；直连无认证则留空
COMFYUI_AUTH_USER=
COMFYUI_AUTH_PASS=
COMFYUI_WORKFLOW_DIR=./workflows

# ============ 可选 ============
# 管理后台密码（至少 16 字符；不配置则首启自动生成并保存到 m0/.private/admin-password）
# DIRECTOR_ADMIN_PASSWORD=
# 智能体接口 /api/agent/submit 的 Bearer Token（不配置则复用管理员密码）
# DIRECTOR_AGENT_TOKEN=
# GPU 被占用时的最长自动排队秒数（默认 1800）
# QUEUE_WAIT_S=1800
# 指定 ffmpeg 可执行文件（默认用系统或 imageio-ffmpeg 自带）
# FFMPEG_BINARY=
# 指定中文字体文件路径（默认在系统字体里找 STHeiti / Songti / Noto CJK）
# CHINESE_FONT=
# 输出目录（默认 m0/out）
# DIRECTOR_OUT=

# ============ SSH 隧道（可选，CLI 工具用） ============
# SSH_HOST=
# SSH_PORT=22
# SSH_USER=
# SSH_PASS=
